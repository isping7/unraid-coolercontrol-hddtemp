    $iv   = max(5, min(60, intval($_POST['interval'] ?? 10)));
    $ds   = isset($_POST['disks']) && is_array($_POST['disks'])
            ? array_values(array_filter($_POST['disks'], fn($s) => is_string($s) && $s !== '')) : [];
    $hm   = in_array($_POST['hdd_mode'] ?? '', ['avg', 'max'], true) ? $_POST['hdd_mode'] : 'avg';
    $sm   = in_array($_POST['ssd_mode'] ?? '', ['avg', 'max'], true) ? $_POST['ssd_mode'] : 'avg';
    $warn = max(20, min(65, intval($_POST['warn'] ?? 40)));
    $hot  = max($warn + 1, min(80, intval($_POST['hot'] ?? 50)));

    if (count($ds) === 0) {
        $err = $L['err_nodisk'];
    } else {
        $old = cct_load_cfg();
        $new = ['i' => $iv, 'd' => $ds, 'e' => true, 'hm' => $hm, 'sm' => $sm, 'warn' => $warn, 'hot' => $hot];
        if (cct_save_cfg($new)) {
            cct_log('配置变更: ' . cct_cfg_diff($old, $new));
            $run = (cct_cli_json($CTL, 'status')['running'] ?? false);
            $msg = $run ? sprintf($L['msg_saved'], $iv) : $L['msg_saved_stopped'];
        } else {
            $err = $L['msg_savefail'];
        }
    }
}

