    $sj = json_decode((string)@file_get_contents($statusFile), true);
    if (is_array($sj)) { $errors = intval($sj['errors'] ?? 0); $elapsed = $sj['elapsed'] ?? null; }
}

$cfg_warn = '';
if (!empty($GLOBALS['CCT_CFG_ERROR'])) $cfg_warn = $L['warn_parse'];
elseif (count($sel) === 0)              $cfg_warn = $L['warn_nodisk'];

$log_lines = [];
if (file_exists($LOG_FILE)) {
    $log_lines = array_slice(array_reverse(file($LOG_FILE, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES)), 0, 60);
}

/** 相对时间（秒 → 中文/英文描述） */
function cct_ago(?int $s, string $lang): string {
    if ($s === null) return '';
    if ($s < 5)    return $lang === 'en' ? 'just now' : '刚刚';
    if ($s < 60)   return $lang === 'en' ? "{$s}s ago" : "{$s} 秒前";
    if ($s < 3600) { $m = (int)floor($s / 60); return $lang === 'en' ? "{$m} min ago" : "{$m} 分钟前"; }
    $h = (int)floor($s / 3600);
    return $lang === 'en' ? "{$h} h ago" : "{$h} 小时前";
}

/** 温度 → 语义色 */
function cct_tcolor(?int $t, int $WARN, int $HOT): string {
    if ($t === null) return 'var(--text)';
    if ($t >= $HOT)  return 'var(--hot)';
    if ($t >= $WARN) return 'var(--warn)';
    return 'var(--ok)';
}

/** 单块盘的行渲染 */
function cct_row(array $d, array $sel, int $WARN, int $HOT): string {
    $sn    = htmlspecialchars($d['serial'], ENT_QUOTES);
    $model = htmlspecialchars($d['model'] ?: $d['dev']);
    $t     = $d['temp'];
    $chk   = (empty($sel) || in_array($d['serial'], $sel, true)) ? 'checked' : '';
    $cls = ''; $color = 'var(--ok)'; $pct = 0;
    if ($t !== null) {
        if ($t >= $HOT)      { $cls = 'hot';  $color = 'var(--hot)'; }
        elseif ($t >= $WARN) { $cls = 'warn'; $color = 'var(--warn)'; }
        $pct = (int) max(0, min(100, ($t - 20) / 40 * 100));
    }
    $tag  = $d['sas'] ? '<span class="tag sas">SAS</span>' : '<span class="tag">SATA</span>';
    $tTxt = $t === null ? '—' : $t . '°C';
    return '<div class="row' . ($cls ? ' ' . $cls : '') . '" data-sn="' . $sn . '">'
         . '<input class="cb" type="checkbox" name="disks[]" value="' . $sn . '" ' . $chk . '>'
         . '<div class="id"><div class="m">' . $model . '</div><div class="s">' . $sn . '</div></div>'
         . $tag
         . '<div class="tm"><span class="t" style="color:' . $color . '">' . $tTxt . '</span>'
         . '<span class="bar"><i style="width:' . $pct . '%;background:' . $color . '"></i></span></div>'
         . '</div>';
}

$rowsJson = json_encode(array_map(function ($d) {
    return ['sn' => $d['serial'], 'model' => $d['model'] ?: $d['dev'],
            'type' => $d['sas'] ? 'SAS' : 'SATA', 'temp' => $d['temp']];
}, array_merge($hdds, $ssds)), JSON_UNESCAPED_UNICODE);
