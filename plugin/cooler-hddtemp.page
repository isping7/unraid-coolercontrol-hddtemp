$ssd_val = file_exists($OUT_SSD) ? intval(trim((string)@file_get_contents($OUT_SSD))) / 1000 : null;
$age     = file_exists($OUT_HDD) ? max(0, time() - filemtime($OUT_HDD)) : null;
$stale   = $run && ($age === null || $age > max(30, $IV * 3));

