// ③ 配置域 -------------------------------------------------------------------
function cct_load_cfg(): array {
    global $CFG;
    $def = ['i' => 10, 'd' => [], 'e' => false, 'hm' => 'avg', 'sm' => 'avg', 'warn' => 40, 'hot' => 50];
    if (!file_exists($CFG)) return $def;
    $c = json_decode((string)@file_get_contents($CFG), true);
    if (!is_array($c)) { $GLOBALS['CCT_CFG_ERROR'] = true; return $def; }
    return array_merge($def, $c);
}

/** 原子写：临时文件 → JSON 校验 → rename（避免采集器读到半截配置） */
function cct_save_cfg(array $cfg): bool {
    global $CFG;
    $tmp  = $CFG . '.tmp';
    $json = json_encode($cfg, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    if ($json === false || @file_put_contents($tmp, $json) === false) return false;
    if (!is_array(json_decode((string)@file_get_contents($tmp), true))) { @unlink($tmp); return false; }
    return @rename($tmp, $CFG);
}

/** 配置差异（含前后值），写审计日志用 */
function cct_cfg_diff(array $old, array $new): string {
    $out = [];
    if (($old['i'] ?? '') != ($new['i'] ?? '')) $out[] = "间隔 {$old['i']}s→{$new['i']}s";
    if (($old['hm'] ?? '') != ($new['hm'] ?? '')) $out[] = "HDD {$old['hm']}→{$new['hm']}";
    if (($old['sm'] ?? '') != ($new['sm'] ?? '')) $out[] = "SSD {$old['sm']}→{$new['sm']}";
    if (($old['warn'] ?? '') != ($new['warn'] ?? '')) $out[] = "告警 {$old['warn']}→{$new['warn']}";
    if (($old['hot'] ?? '') != ($new['hot'] ?? '')) $out[] = "高温 {$old['hot']}→{$new['hot']}";
    $oc = is_array($old['d'] ?? null) ? count($old['d']) : 0;
    $nc = is_array($new['d'] ?? null) ? count($new['d']) : 0;
    if ($oc != $nc) $out[] = "盘数 {$oc}→{$nc}";
    return $out ? implode('; ', $out) : '无字段变化';
}

// ④ 跨域调用 ----------------------------------------------------------------
/** 调用 CLI 子模块并解析 JSON */
function cct_cli_json(string $script, string $arg = ''): array {
    $cmd = 'php ' . escapeshellarg($script) . ($arg !== '' ? ' ' . escapeshellarg($arg) : '') . ' 2>/dev/null';
    $o = [];
    exec($cmd, $o);
    $j = json_decode(implode("\n", $o), true);
    return is_array($j) ? $j : [];
}

/** 统一时间戳：走 shell date，保证与采集器同源（PHP CLI 默认 UTC，emhttp 下才是本地时区） */
function cct_now(): string {
    $t = trim((string)@shell_exec('date "+%Y-%m-%d %H:%M:%S" 2>/dev/null'));
    return $t !== '' ? $t : date('Y-m-d H:i:s');
}

function cct_log(string $line): void {
    global $LOG_FILE;
    @file_put_contents($LOG_FILE, '[' . cct_now() . "] [INFO] $line\n", FILE_APPEND);
}

