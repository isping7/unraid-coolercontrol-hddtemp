                'checked' => (empty($s) || in_array($d['serial'], $s, true))];
    };
    echo json_encode(['hdd' => array_map($mk, $aa['hdd'] ?? []),
                      'ssd' => array_map($mk, $aa['ssd'] ?? [])], JSON_UNESCAPED_UNICODE);
    exit;
}

// ⑥ 动作：保存 / 启动 --------------------------------------------------
$msg = ''; $err = '';

