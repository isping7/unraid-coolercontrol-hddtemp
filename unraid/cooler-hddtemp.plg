<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ELEMENT PLUGIN (NAME,AUTHOR,VERSION,DATE,DESCRIPTION,CHANGES,FILE*,INSTALL?)>
<!ELEMENT NAME (#PCDATA)>
<!ELEMENT AUTHOR (#PCDATA)>
<!ELEMENT VERSION (#PCDATA)>
<!ELEMENT DATE (#PCDATA)>
<!ELEMENT DESCRIPTION (#PCDATA)>
<!ELEMENT CHANGES (#PCDATA)>
<!ELEMENT FILE (URL,MD5)>
<!ELEMENT URL (#PCDATA)>
<!ELEMENT MD5 (#PCDATA)>
<!ELEMENT INSTALL (#PCDATA)>
]>
<PLUGIN name="cooler-hddtemp" author="mac-ping" version="2026.11.17.1" pluginURL="https://github.com/isping7/unraid-coolercontrol-hddtemp" minVersion="7.0" launch="Settings/cooler-hddtemp" support="https://github.com/isping7/unraid-coolercontrol-hddtemp/issues">
<NAME>Drive Temperature (cooler-hddtemp)</NAME>
<AUTHOR>mac-ping</AUTHOR>
<VERSION>2026.11.17.1</VERSION>
<DATE>2026-11-17</DATE>
<DESCRIPTION>
Collect HDD/SSD temperatures with smartctl and publish them as millidegree files for
CoolerControl file sensors. Max or average aggregation, hot-reload settings, dual-pane
WebUI, auto-add new drives, self-test script.
</DESCRIPTION>
<CHANGES>
[2026.11.17.1] v3.1.0: auto-add new drives (opt-in, HDD/SSD decided by smartctl).
[2026.11.17] v3.0: split architecture, single-page i18n, hot-reload saves, atomic config writes,
configurable thresholds, dual-pane responsive UI, selftest.sh; removed the stop button.
</CHANGES>
