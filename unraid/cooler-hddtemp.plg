<FILE Name="/boot/config/plugins/cooler-hddtemp/bin/selftest.sh">
<URL>https://raw.githubusercontent.com/isping7/unraid-coolercontrol-hddtemp/main/plugin/bin/selftest.sh</URL>
<MD5>1055baf0973478b7cdd788b1e17df79a</MD5>
</FILE>


<INSTALL>
#!/bin/bash
mkdir -p /usr/local/emhttp/plugins/cooler-hddtemp/assets
cp -f /boot/config/plugins/cooler-hddtemp/cooler-hddtemp.page /usr/local/emhttp/plugins/cooler-hddtemp/
cp -f /boot/config/plugins/cooler-hddtemp/cooler-hddtemp-en.page /usr/local/emhttp/plugins/cooler-hddtemp/
cp -f /boot/config/plugins/cooler-hddtemp/assets/cct.css /boot/config/plugins/cooler-hddtemp/assets/cct.js /usr/local/emhttp/plugins/cooler-hddtemp/assets/
chmod 644 /usr/local/emhttp/plugins/cooler-hddtemp/*.page /usr/local/emhttp/plugins/cooler-hddtemp/assets/* 2&gt;/dev/null
if ! grep -q "cooler-hddtemp/assets/cct.css" /boot/config/go; then
  echo "mkdir -p /usr/local/emhttp/plugins/cooler-hddtemp/assets" &gt;&gt; /boot/config/go
  echo "cp /boot/config/plugins/cooler-hddtemp/assets/cct.css /boot/config/plugins/cooler-hddtemp/assets/cct.js /usr/local/emhttp/plugins/cooler-hddtemp/assets/" &gt;&gt; /boot/config/go
fi
echo "cooler-hddtemp installed. Start the collector with a User Scripts entry (At Startup of Array)."</INSTALL>
</PLUGIN>
